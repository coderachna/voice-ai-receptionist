# LiveKit Cloud (free project at cloud.livekit.io) - not needed for `console` mode
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

DEEPGRAM_API_KEY=
GROQ_API_KEY=
ELEVEN_API_KEY=
ELEVEN_VOICE_ID=
ELEVEN_MODEL=eleven_flash_v2_5

# Check live model IDs: curl https://api.groq.com/openai/v1/models -H "Authorization: Bearer $GROQ_API_KEY"
GROQ_MODEL=openai/gpt-oss-20b
STT_LANGUAGE=multi

GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json
GOOGLE_CALENDAR_ID=yourcalendar@gmail.com

BUSINESS_NAME=Sharma Dental Clinic
BUSINESS_TIMEZONE=Asia/Kolkata
OPEN_HOUR=10
CLOSE_HOUR=19
CLOSED_WEEKDAYS=6
SLOT_MINUTES=30
MIN_NOTICE_MINUTES=30
